# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- deployment tooling -----------------------------------------------------
# Only needed when the compose file is managed separately from the project
# checkout (e.g. pasted into Portainer's "Web editor"): set this to the
# absolute path where this repo was copied on the NAS, so the uploader's
# build context and secrets bind-mount can still be found. Leave unset when
# running `docker compose` directly from the repo root. See README
# "Deploying via Portainer".
# PROJECT_DIR=/volume1/docker/scanner-drive-bridge

# --- smb1-printer -----------------------------------------------------------
# A free static IP on your smb1_network subnet. The scanner is configured to
# connect to this exact address, so keep it stable once chosen.
SMB1_STATIC_IP=192.0.2.20

# Password for the existing DSM user `prt01`, used by the legacy scanner's
# SMB1 connection. Required. The dperson/samba image only accepts this as a
# command-line argument (not a secrets file), so it goes through .env instead.
SMB_PRT01_PASSWORD=changeme

# --- drive-uploader -----------------------------------------------------------
# The actual DSM/Synology Drive password is NOT set here: put it in
# ./secrets/synology_password (see secrets/.gitkeep). This section only
# covers non-secret connection settings.

# Required -- no sensible default exists. Use your NAS's LAN IP or hostname.
SYNOLOGY_HOST=https://192.0.2.10:5001
SYNOLOGY_USERNAME=prt01
SYNOLOGY_DSM_VERSION=7
SYNOLOGY_DESTINATION=/team-folders/printer

# Keep TLS verification on. If the NAS uses a self-signed/internal CA,
# export its certificate and place it at ./secrets/synology_ca instead of
# turning this off.
SYNOLOGY_VERIFY_TLS=true

CONFLICT_ACTION=autorename

# File-stabilization / polling tuning. For a slow or flaky legacy SMB1
# transfer, increase both -- the required settle margin is roughly
# STABILITY_CHECKS * STABILITY_INTERVAL_SECONDS.
STABILITY_INTERVAL_SECONDS=2
STABILITY_CHECKS=2
SCAN_INTERVAL_SECONDS=2

# Set to false only if the scanner itself infers its next filename by
# listing /incoming and gets confused finding it always empty. Content-hash
# dedup still guarantees a kept file is never re-uploaded.
DELETE_AFTER_UPLOAD=true

# Only relevant when DELETE_AFTER_UPLOAD=false: auto-remove a kept local
# copy this many hours after confirmed upload, so /incoming doesn't grow
# without bound. Leave unset/empty to keep every copy forever.
LOCAL_RETENTION_HOURS=

# Cosmetic only: prefixes the name sent to Synology Drive (never the local
# /incoming filename) with today's date, e.g. SCN_0001.pdf ->
# 2026-08-22_SCN_0001.pdf, for easier browsing in the Team Folder.
TIMESTAMP_UPLOAD_FILENAME=false

# Comma-separated retry backoff schedule in seconds; the last value repeats
# indefinitely once exhausted.
RETRY_BACKOFF_SECONDS=5,15,30,60,300

LOG_LEVEL=INFO
